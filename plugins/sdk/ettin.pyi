"""Type stubs for the Ettin Edit plugin API (ettin.py), for editors that
check types or complete names. Ettin Edit copies this file next to new
plugins; the real module is on the plugin's path when Ettin Edit runs it."""

from collections.abc import Callable, Iterable, Iterator, MutableMapping
from typing import Any, Literal, TypeVar, overload

_F = TypeVar("_F", bound=Callable[..., Any])

MarkStyle = Literal["underline-squiggle", "background", "gutter-icon"]
MarkColor = Literal["error", "warning", "info", "accent"]
Event = Literal["opened", "saved", "closed", "activated", "changed", "caret", "shutdown",
                "settings.changed"]
Item = dict[str, Any]

info: dict[str, Any]

class EttinError(Exception): ...

class TransformError(Exception):
    line: int | None
    column: int | None
    def __init__(self, message: str, line: int | None = ..., column: int | None = ...) -> None: ...

class Selection:
    start: int
    end: int
    anchor: int
    head: int
    text: str

class Document:
    id: int
    @property
    def title(self) -> str: ...
    @property
    def path(self) -> str | None: ...
    @property
    def language(self) -> str: ...
    @property
    def modified(self) -> bool: ...
    @property
    def read_only(self) -> bool: ...
    @property
    def length(self) -> int: ...
    @property
    def line_count(self) -> int: ...
    @property
    def encoding(self) -> str: ...
    @property
    def line_ending(self) -> str: ...
    @property
    def caret(self) -> tuple[int, int]: ...
    @property
    def caret_offset(self) -> int: ...
    text: str
    def refresh(self) -> Document: ...
    def get_text(self, start: int | None = ..., end: int | None = ...) -> str: ...
    def set_text(self, text: str) -> None: ...
    def replace(self, start: int, end: int, text: str) -> None: ...
    def insert(self, text: str) -> None: ...
    def selections(self) -> list[Selection]: ...
    def selected_text(self) -> str: ...
    def replace_selections(self, text: str | Iterable[str]) -> None: ...
    def select(self, start: int, end: int | None = ...) -> None: ...
    def select_ranges(self, ranges: Iterable[tuple[int, int]]) -> None: ...
    def goto(self, line: int, column: int = ...) -> None: ...
    def save(self) -> bool: ...
    def activate(self) -> None: ...
    def close(self) -> None: ...
    def mark(self, id: str, ranges: Iterable[tuple[int, int]], style: MarkStyle = ...,
             color: MarkColor = ..., message: str | None = ...) -> None: ...
    def clear_marks(self, id: str) -> None: ...

class Settings(MutableMapping[str, Any]):
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def update_all(self, values: dict[str, Any]) -> None: ...

settings: Settings

def data_dir() -> str: ...
def call(method: str, **params: Any) -> Any: ...
def notify(method: str, **params: Any) -> None: ...
def active() -> Document: ...
def documents() -> list[Document]: ...
def open_file(path: str) -> Document: ...
def new_document(text: str = ..., language: str | None = ...) -> Document: ...
def message(text: str, kind: Literal["info", "warning", "error"] = ...) -> None: ...
def prompt(text: str, value: str = ..., title: str | None = ...) -> str | None: ...
@overload
def choose(items: Iterable[str], title: str | None = ..., placeholder: str | None = ...) -> str | None: ...
@overload
def choose(items: Iterable[Item], title: str | None = ..., placeholder: str | None = ...) -> Item | None: ...
def status(id: str, text: str, tooltip: str | None = ..., command: str | None = ...) -> None: ...
def set_clipboard(text: str) -> None: ...
def run_action(action: str | dict[str, Any]) -> None: ...
def ui_language() -> str: ...
def log(*args: Any) -> None: ...
def command(title: str, shortcut: str | None = ..., id: str | None = ...,
            icon: str | None = ...) -> Callable[[_F], _F]: ...
def transform(title: str, options: dict[str, Any] | None = ..., id: str | None = ...,
              languages: str | list[str] | None = ...) -> Callable[[_F], _F]: ...
def on(event: Event) -> Callable[[_F], _F]: ...
def on_panel(panel_id: str) -> Callable[[_F], _F]: ...
def show_panel(id: str, title: str, items: list[Item], position: Literal["right", "bottom"] = ...,
               scroll_to_top: bool = ...) -> None: ...
def close_panel(id: str) -> None: ...
def run() -> None: ...

class ui:
    @staticmethod
    def heading(text: str) -> Item: ...
    @staticmethod
    def label(text: str, weak: bool = ..., mono: bool = ...) -> Item: ...
    @staticmethod
    def separator() -> Item: ...
    @staticmethod
    def button(id: str, label: str) -> Item: ...
    @staticmethod
    def input(id: str, label: str = ..., value: str = ..., hint: str = ..., multiline: bool = ...) -> Item: ...
    @staticmethod
    def checkbox(id: str, label: str, value: bool = ...) -> Item: ...
    @staticmethod
    def select(id: str, options: Iterable[str], value: str = ..., label: str = ...) -> Item: ...
    @staticmethod
    def row(*items: Item) -> Item: ...
    @staticmethod
    def tree(id: str, nodes: Iterable[Item], selected: str | None = ...) -> Item: ...
    @staticmethod
    def node(label: str, id: str = ..., detail: str = ..., children: Iterable[Item] | None = ...,
             open: bool | None = ...) -> Item: ...
    @staticmethod
    def markdown(text: str, id: str = ..., base: str | None = ..., doc: Document | int | None = ...,
                 line: int = ...) -> Item: ...
    @staticmethod
    def table(id: str, columns: Iterable[str], rows: Iterable[Iterable[Any]]) -> Item: ...
