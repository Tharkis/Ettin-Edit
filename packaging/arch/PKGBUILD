# Builds Ettin Edit from the checkout this file lives in.
# Usage: cd packaging/arch && makepkg -si
pkgname=ettin-edit
pkgver=1.0.0
pkgrel=1
pkgdesc="A modern, cross-platform text editor"
arch=('x86_64' 'aarch64')
url="https://github.com/Tharkis/Ettin-Edit"
license=('custom')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'libxkbcommon-x11' 'libgl' 'xdg-desktop-portal' 'hicolor-icon-theme')
makedepends=('cargo')
options=('!lto' '!debug')

_root() { realpath "$startdir/../.."; }

prepare() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  cd "$(_root)"
  install -Dm755 "$srcdir/target/release/ettin-edit" "$pkgdir/usr/bin/ettin-edit"
  install -Dm644 packaging/linux/ettin-edit.desktop "$pkgdir/usr/share/applications/ettin-edit.desktop"
  install -Dm644 assets/icons/ettin-edit.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ettin-edit.svg"
  install -Dm644 assets/icons/ettin-edit-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ettin-edit.png"
  install -Dm644 assets/icons/ettin-edit-32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/ettin-edit.png"
  install -Dm644 assets/icons/ettin-edit-48.png "$pkgdir/usr/share/icons/hicolor/48x48/apps/ettin-edit.png"
  install -Dm644 assets/icons/ettin-edit-64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/ettin-edit.png"
  install -Dm644 assets/icons/ettin-edit-128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/ettin-edit.png"
}
